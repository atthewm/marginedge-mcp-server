# MarginEdge API
MARGINEDGE_API_KEY=your_api_key_here
MARGINEDGE_RESTAURANT_ID=your_restaurant_unit_id
MARGINEDGE_API_HOST=https://api.marginedge.com/public

# Transport: "stdio" for local MCP clients, "http" for cloud deployments
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3001

# MCP API key for HTTP transport authentication (optional for stdio)
# MCP_API_KEY=

# Entra ID / OAuth authentication for HTTP transport (optional)
# ENTRA_ID_TENANT_ID=
# ENTRA_ID_CLIENT_ID=
# ENTRA_ID_AUDIENCE=

# Logging: debug, info, warn, error
LOG_LEVEL=info
